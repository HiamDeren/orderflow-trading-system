{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/app/**",
      "apps/web/lib/**",
      "apps/web/tests/**",
      "apps/web/proxy.ts",
      "apps/web/next.config.ts",
      "apps/web/vitest.config.mts",
      "scripts/*.mjs",
      "!**/*.snap",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "warn",
        "useExponentiationOperator": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "complexity": {
        "noUselessEscapeInRegex": "warn",
        "noCommaOperator": "warn",
        "useOptionalChain": "warn"
      },
      "suspicious": {
        "noDocumentCookie": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
